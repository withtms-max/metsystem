# pnpm 설정 — Windows + OneDrive 환경 최적화

# pnpm 스토어를 OneDrive 밖으로 이동 (파일 잠금/동기화 충돌 방지)
store-dir=C:\Users\이병길\.pnpm-store

# Windows에서 심볼릭 링크 대신 직접 복사 모드 사용
# (OneDrive가 심볼릭 링크를 동기화하려다 깨지는 문제 해결)
node-linker=hoisted

# Expo + React Native 호환성을 위해 strict peer deps 완화
strict-peer-dependencies=false
auto-install-peers=true

# 워크스페이스 프로토콜 명시
link-workspace-packages=true
prefer-workspace-packages=true
