# pnpm 설정 — Windows 환경 최적화 (C:\dev 위치 가정)

# pnpm 스토어 위치 (OneDrive 밖)
store-dir=C:\Users\이병길\.pnpm-store

# Windows에서 심볼릭 링크 대신 hoisted 모드 (호환성)
node-linker=hoisted

# Expo + React Native 호환성을 위해 strict peer deps 완화
strict-peer-dependencies=false
auto-install-peers=true

# 워크스페이스 프로토콜 명시
link-workspace-packages=true
prefer-workspace-packages=true

# pnpm 11: 실행 전 의존성 무결성 검증 끄기 (수동 명령 차단 방지)
verify-deps-before-run=false
